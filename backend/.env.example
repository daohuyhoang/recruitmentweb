# Sao chép thành .env rồi sửa cho máy của bạn
# Mật khẩu có ký tự đặc biệt (@ : / #) phải mã hóa URL, ví dụ @ -> %40
DATABASE_URL=mysql+pymysql://root:MAT_KHAU@localhost:3306/recruitment?charset=utf8mb4

# Chuỗi bí mật ký JWT, đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=5

# false: không tải model Sentence-BERT (thuật toán 3), trọng số được chia lại cho 3 thành phần còn lại
SEMANTIC_ENABLED=true
